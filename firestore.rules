rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTlOrManager() {
      return isSignedIn() && (userRole() == 'tl' || userRole() == 'manager');
    }

    function isManager() {
      return isSignedIn() && userRole() == 'manager';
    }

    // assigned_to can be a list (new tasks) or a plain string (old tasks).
    function isAssignee(taskData) {
      let a = taskData.get('assigned_to', []);
      return (a is list && a.hasAny([request.auth.uid]))
          || (a is string && a == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTlOrManager());
      allow create: if isManager();
      allow update: if (
          isManager()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'name', 'email', 'client_ids', 'all_clients'])
        ) || (
          isTlOrManager()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['client_ids'])
        );
      allow delete: if isManager();
    }

    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTlOrManager();
    }

    match /client_groups/{groupId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTlOrManager();
    }

    match /sops/{sopId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTlOrManager();
    }

    match /task_templates/{templateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTlOrManager();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isTlOrManager();
      allow delete: if isTlOrManager();
      allow update: if isTlOrManager()
        || (
          isSignedIn()
          && isAssignee(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completed_at', 'completed_by'])
        );
    }

    match /task_comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Kept so re-enabling the reminder workflow later needs no rules change.
    match /reminder_runs/{runId} {
      allow read, create, delete: if isManager();
      allow update: if false;
    }
  }
}
