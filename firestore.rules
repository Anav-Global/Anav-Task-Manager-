rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTlOrManager() {
      return isSignedIn() && (userRole() == 'tl' || userRole() == 'manager');
    }

    function isManager() {
      return isSignedIn() && userRole() == 'manager';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTlOrManager());
      allow create: if isManager();
      allow update, delete: if isManager();
    }

    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTlOrManager();
    }

    match /client_groups/{groupId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTlOrManager();
    }

    match /sops/{sopId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTlOrManager();
    }

    match /task_templates/{templateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTlOrManager();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isTlOrManager();
      allow delete: if isTlOrManager();

      allow update: if isTlOrManager()
        || (
          isSignedIn()
          && resource.data.assigned_to == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'completed_at', 'completed_by'])
        );
    }

    match /task_comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
